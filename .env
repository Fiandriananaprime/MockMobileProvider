# Template only: the app does not load .env automatically. Export these values or configure them in your host.

# Runtime
NODE_ENV=development
PORT=4010
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL connection string for persistent mock accounts + transactions.
DATABASE_URL=postgres://novaadmin:Fiandrianana1357@localhost:5432/mock_provider

# User access token signing key; provide at least 32 random bytes.
USER_AUTH_SECRET=foifhmfioumzoqriuzriuazdiozmfohqmfaoizrazmhMSHAZIUFGLFIGAZFLZUIF
MAX_BALANCE=10000000
MVOLA_MSISDN_PREFIXES=034,038
ORANGE_MONEY_MSISDN_PREFIXES=032,037
USER_FRONTEND_ORIGINS=http://localhost:5175
ADMIN_FRONTEND_ORIGINS=http://localhost:5176

# Public origin used to build Orange payment_url. Production requires an absolute HTTPS URL.
PUBLIC_BASE_URL=http://localhost:4010

# Required in production; leave empty for local development.
MOCK_ADMIN_TOKEN=
MVOLA_CLIENT_KEY=
MVOLA_CLIENT_SECRET=
# Full Basic authorization value, e.g. Basic <base64(client_id:client_secret)>.
ORANGE_BASIC_AUTH=
# Comma-separated callback hostnames, without scheme or paths. Production requires at least one.
CALLBACK_ALLOWED_HOSTS=

# Vercel sets this automatically. PUBLIC_BASE_URL takes precedence when both are set.
