{
  "name": "mobileMoneyProvider",
  "version": "3.0.0",
  "private": true,
  "description": "Fake MVola / Orange Money provider for local development and testing of a Payment Service. In-memory only.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "test": "npm run build && node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^8.0.2",
    "dotenv": "^18.0.4",
    "fastify": "^5.6.0",
    "jose": "^6.2.12",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
